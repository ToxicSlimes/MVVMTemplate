.lobby-panel {
    max-width: 900px;
}

.room-code {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 14px;
    color: var(--color-accent);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-shadow);
    margin-right: var(--space-sm);
}

.copy-button {
    min-width: 88px;
    font-size: 8px;
}

.slots-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: var(--space-md) 0;
}

.slot-card {
    width: 48%;
    min-height: 120px;
    margin-bottom: var(--space-sm);
    padding: var(--space-md);
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-none);
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--color-panel-light);
    border-top-color: var(--color-panel-light);
    border-right-color: var(--color-panel-dark);
    border-bottom-color: var(--color-panel-dark);
    display: none;
}

.slot-name {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 10px;
    color: var(--color-text-primary);
}

.slot-role {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
}

.slot-ready {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-primary);
    margin-top: var(--space-sm);
    display: none;
}

.ready-toggle {
    margin-bottom: var(--space-sm);
}

.start-label-hidden {
    display: none;
}
