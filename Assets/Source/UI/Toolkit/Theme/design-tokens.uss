:root {
    --color-sky-top: rgb(86, 196, 255);
    --color-sky-bottom: rgb(58, 42, 120);
    --color-bg-deep: rgb(34, 20, 72);
    --color-bg-surface: rgb(58, 42, 96);
    --color-bg-elevated: rgb(74, 56, 118);
    --color-panel-light: rgb(255, 230, 150);
    --color-panel-dark: rgb(35, 22, 55);
    --color-primary: rgb(92, 214, 122);
    --color-primary-dark: rgb(44, 140, 72);
    --color-primary-light: rgb(180, 255, 196);
    --color-accent: rgb(255, 223, 88);
    --color-accent-dark: rgb(210, 150, 40);
    --color-candy-pink: rgb(255, 130, 178);
    --color-candy-blue: rgb(110, 198, 255);
    --color-danger: rgb(255, 108, 108);
    --color-danger-dark: rgb(180, 48, 48);
    --color-text-primary: rgb(255, 248, 220);
    --color-text-secondary: rgb(196, 176, 232);
    --color-text-shadow: rgb(55, 30, 90);
    --color-outline: rgb(24, 12, 48);
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;
    --radius-none: 0;
    --border-chunky: 4px;
    --pixel-step: 4px;
}
