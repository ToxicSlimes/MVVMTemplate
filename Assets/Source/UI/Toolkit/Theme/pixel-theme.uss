.font-pixel {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
}

.font-pixel-body {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 10px;
    color: var(--color-text-primary);
}

.font-pixel-caption {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
}

.title-pixel {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 22px;
    color: var(--color-accent);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-text-shadow);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-sm);
    letter-spacing: 1px;
}

.subtitle-pixel {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-candy-blue);
    -unity-text-align: middle-center;
    white-space: normal;
}

.panel-pixel {
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-none);
    border-left-width: var(--border-chunky);
    border-top-width: var(--border-chunky);
    border-right-width: var(--border-chunky);
    border-bottom-width: var(--border-chunky);
    border-left-color: var(--color-panel-light);
    border-top-color: var(--color-panel-light);
    border-right-color: var(--color-panel-dark);
    border-bottom-color: var(--color-panel-dark);
    padding: var(--space-lg);
}

.panel-pixel-inset {
    background-color: var(--color-bg-deep);
    border-radius: var(--radius-none);
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--color-panel-dark);
    border-top-color: var(--color-panel-dark);
    border-right-color: var(--color-panel-light);
    border-bottom-color: var(--color-panel-light);
    padding: var(--space-sm);
}

.btn {
    min-height: 44px;
    border-radius: var(--radius-none);
    margin: var(--space-xs) 0;
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 10px;
    color: var(--color-text-primary);
    border-left-width: var(--border-chunky);
    border-top-width: var(--border-chunky);
    border-right-width: var(--border-chunky);
    border-bottom-width: var(--border-chunky);
    transition-duration: 0.08s;
    transition-property: translate, background-color, border-color;
}

.btn:hover {
    scale: 1.02 1.02;
}

.btn:active {
    translate: 2px 2px;
}

.btn-primary {
    background-color: var(--color-primary);
    border-left-color: var(--color-primary-light);
    border-top-color: var(--color-primary-light);
    border-right-color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary-dark);
    min-height: 52px;
    font-size: 11px;
    color: var(--color-outline);
}

.btn-primary:hover {
    background-color: rgb(118, 232, 148);
}

.btn-primary:active {
    border-left-color: var(--color-primary-dark);
    border-top-color: var(--color-primary-dark);
    border-right-color: var(--color-primary-light);
    border-bottom-color: var(--color-primary-light);
}

.btn-secondary {
    background-color: var(--color-bg-elevated);
    border-left-color: rgb(130, 110, 170);
    border-top-color: rgb(130, 110, 170);
    border-right-color: var(--color-panel-dark);
    border-bottom-color: var(--color-panel-dark);
}

.btn-outline {
    background-color: rgb(48, 34, 82);
    border-left-color: var(--color-candy-blue);
    border-top-color: var(--color-candy-blue);
    border-right-color: rgb(40, 90, 140);
    border-bottom-color: rgb(40, 90, 140);
    color: var(--color-candy-blue);
}

.btn-outline:hover {
    background-color: rgb(58, 44, 98);
    color: var(--color-text-primary);
}

.btn-danger {
    background-color: var(--color-danger);
    border-left-color: rgb(255, 170, 170);
    border-top-color: rgb(255, 170, 170);
    border-right-color: var(--color-danger-dark);
    border-bottom-color: var(--color-danger-dark);
    color: var(--color-outline);
}

.btn-ghost {
    background-color: transparent;
    border-left-color: transparent;
    border-top-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    color: var(--color-text-secondary);
    font-size: 8px;
}

.btn-ghost:hover {
    color: var(--color-candy-pink);
}

.pixel-star {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: var(--radius-none);
}

.pixel-cloud {
    position: absolute;
    flex-direction: row;
    align-items: flex-end;
}

.pixel-cloud-block {
    background-color: rgba(255, 255, 255, 0.88);
    border-radius: var(--radius-none);
    margin-right: 2px;
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(180, 200, 220);
    border-bottom-color: rgb(180, 200, 220);
}

.screen-title {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 16px;
    color: var(--color-accent);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-shadow);
    margin-bottom: var(--space-md);
}

.screen-subtitle {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    white-space: normal;
}

.field-label {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
}

.field-value {
    -unity-font-definition: url('Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
}
