.screen-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-deep);
    background-image: linear-gradient(180deg, var(--color-sky-top) 0%, var(--color-sky-bottom) 55%, var(--color-bg-deep) 100%);
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
}

.screen-panel {
    width: 90%;
    max-width: 720px;
    align-items: stretch;
}

.field-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
}

.field-label {
    font-size: 8px;
    color: var(--color-text-primary);
    min-width: 140px;
}

.field-value {
    font-size: 8px;
    color: var(--color-text-secondary);
    min-width: 56px;
    -unity-text-align: middle-right;
}

.scroll-panel {
    max-height: 280px;
    margin-bottom: var(--space-sm);
}

.progress-track {
    height: 12px;
    background-color: var(--color-bg-deep);
    border-radius: var(--radius-none);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-panel-dark);
    border-top-color: var(--color-panel-dark);
    border-right-color: var(--color-panel-light);
    border-bottom-color: var(--color-panel-light);
    overflow: hidden;
    margin: var(--space-md) 0;
}

.progress-fill {
    height: 100%;
    background-color: var(--color-primary);
    width: 0%;
    border-radius: var(--radius-none);
}

.overlay-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 8, 40, 0.72);
    align-items: center;
    justify-content: center;
}
