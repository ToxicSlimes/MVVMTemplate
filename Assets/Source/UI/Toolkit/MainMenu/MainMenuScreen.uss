.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-deep);
    background-image: linear-gradient(180deg, var(--color-sky-top) 0%, var(--color-sky-bottom) 48%, var(--color-bg-deep) 100%);
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
}

.menu-bg-decor {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.menu-star-1 {
    left: 12%;
    top: 14%;
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
}

.menu-star-2 {
    left: 78%;
    top: 18%;
    width: 6px;
    height: 6px;
    background-color: var(--color-candy-pink);
}

.menu-star-3 {
    left: 86%;
    top: 32%;
    width: 8px;
    height: 8px;
    background-color: var(--color-candy-blue);
}

.menu-star-4 {
    left: 8%;
    top: 62%;
    width: 6px;
    height: 6px;
    background-color: var(--color-primary-light);
}

.menu-star-5 {
    left: 90%;
    top: 72%;
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
}

.menu-cloud-left {
    left: 6%;
    top: 22%;
}

.menu-cloud-right {
    right: 8%;
    top: 12%;
}

.cloud-a {
    width: 28px;
    height: 16px;
}

.cloud-b {
    width: 36px;
    height: 22px;
    margin-bottom: 4px;
}

.cloud-c {
    width: 22px;
    height: 14px;
}

.cloud-d {
    width: 24px;
    height: 14px;
}

.cloud-e {
    width: 40px;
    height: 24px;
    margin-bottom: 6px;
}

.cloud-f {
    width: 20px;
    height: 12px;
}

.menu-card {
    width: 92%;
    max-width: 460px;
    align-items: center;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
}

.menu-badge {
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-md);
    align-items: center;
    justify-content: center;
    position: relative;
}

.menu-badge-core {
    width: 40px;
    height: 40px;
    background-color: var(--color-candy-pink);
    border-radius: var(--radius-none);
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(255, 190, 210);
    border-top-color: rgb(255, 190, 210);
    border-right-color: rgb(180, 70, 120);
    border-bottom-color: rgb(180, 70, 120);
}

.menu-badge-shine {
    position: absolute;
    left: 10px;
    top: 8px;
    width: 8px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.9);
}

.menu-header {
    align-items: center;
    margin-bottom: var(--space-lg);
    width: 100%;
}

.menu-title {
    font-size: 18px;
    margin-bottom: var(--space-md);
}

.menu-subtitle {
    max-width: 360px;
}

.menu-actions {
    width: 100%;
    align-items: stretch;
    margin-bottom: var(--space-sm);
}

.menu-footer {
    position: absolute;
    left: var(--space-lg);
    right: var(--space-lg);
    bottom: var(--space-md);
    flex-direction: row;
    justify-content: space-between;
}

.menu-footer-version {
    -unity-text-align: middle-right;
}

.menu-play {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
}
