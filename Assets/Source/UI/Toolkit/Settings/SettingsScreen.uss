.settings-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
}

.settings-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    border-width: 0;
    margin: 0;
    padding: 0;
}

.settings-panel {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 8%;
    bottom: 8%;
    padding: var(--space-lg);
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-lg);
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.settings-close {
    min-width: 40px;
    min-height: 40px;
}

.settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin: var(--space-md) 0;
}

.tab-button {
    margin-right: var(--space-xs);
    min-height: 36px;
    font-size: 13px;
}

.tab-button-active {
    background-color: var(--color-accent);
    color: var(--color-bg-deep);
}

.tab-content {
    display: none;
    padding: var(--space-sm);
}

.tab-content-active {
    display: flex;
}

.settings-content-scroll {
    flex-grow: 1;
    max-height: 420px;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: var(--space-md);
}

.settings-footer .btn {
    margin-left: var(--space-xs);
    min-width: 88px;
}
