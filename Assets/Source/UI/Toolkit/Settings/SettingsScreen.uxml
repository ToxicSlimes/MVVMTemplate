<!-- Generated from settings.screen.json - do not edit -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Theme/design-tokens.uss" />
    <Style src="../Theme/pixel-theme.uss" />
    <Style src="../Theme/pixel-controls.uss" />
    <Style src="../Theme/toolkit-screen.uss" />
    <Style src="SettingsScreen.uss" />
    <ui:VisualElement class="settings-overlay">
        <ui:Button name="dim-button" class="settings-dim" />
        <ui:VisualElement class="settings-panel">
            <ui:VisualElement class="settings-header">
                <ui:Label text="SETTINGS" class="screen-title" />
                <ui:Button name="close-button" text="X" class="btn btn-ghost settings-close" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-tabs">
                <ui:Button name="tab-audio" text="Audio" class="btn btn-outline tab-button" />
                <ui:Button name="tab-video" text="Video" class="btn btn-outline tab-button" />
                <ui:Button name="tab-display" text="Display" class="btn btn-outline tab-button" />
                <ui:Button name="tab-controls" text="Controls" class="btn btn-outline tab-button" />
                <ui:Button name="tab-game" text="Game" class="btn btn-outline tab-button" />
            </ui:VisualElement>
            <ui:ScrollView class="settings-content-scroll">
                <ui:VisualElement name="content-audio" class="tab-content">
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Master" class="settings-field-label" />
                        <ui:Slider name="master-volume" label="" low-value="0" high-value="1" class="pixel-slider" />
                        <ui:Label name="master-volume-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Music" class="settings-field-label" />
                        <ui:Slider name="music-volume" label="" low-value="0" high-value="1" class="pixel-slider" />
                        <ui:Label name="music-volume-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="SFX" class="settings-field-label" />
                        <ui:Slider name="sfx-volume" label="" low-value="0" high-value="1" class="pixel-slider" />
                        <ui:Label name="sfx-volume-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Voice" class="settings-field-label" />
                        <ui:Slider name="voice-volume" label="" low-value="0" high-value="1" class="pixel-slider" />
                        <ui:Label name="voice-volume-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-toggle-group">
                        <ui:Toggle name="mute-all-toggle" label="Mute All" class="pixel-toggle" />
                        <ui:Toggle name="mute-music-toggle" label="Mute Music" class="pixel-toggle" />
                        <ui:Toggle name="mute-sfx-toggle" label="Mute SFX" class="pixel-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="content-video" class="tab-content">
                    <ui:DropdownField name="resolution-dropdown" label="Resolution" class="pixel-dropdown" />
                    <ui:DropdownField name="quality-dropdown" label="Quality" class="pixel-dropdown" />
                    <ui:Toggle name="fullscreen-toggle" label="Fullscreen" class="pixel-toggle" />
                    <ui:Toggle name="vsync-toggle" label="VSync" class="pixel-toggle" />
                    <ui:Toggle name="show-fps-toggle" label="Show FPS" class="pixel-toggle" />
                    <ui:DropdownField name="target-fps-dropdown" label="Target FPS" class="pixel-dropdown" />
                </ui:VisualElement>
                <ui:VisualElement name="content-display" class="tab-content">
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Brightness" class="settings-field-label" />
                        <ui:Slider name="brightness-slider" label="" low-value="0" high-value="1" class="pixel-slider" />
                        <ui:Label name="brightness-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Gamma" class="settings-field-label" />
                        <ui:Slider name="gamma-slider" label="" low-value="0.5" high-value="2" class="pixel-slider" />
                        <ui:Label name="gamma-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="UI Scale" class="settings-field-label" />
                        <ui:Slider name="ui-scale-slider" label="" low-value="0.75" high-value="1.5" class="pixel-slider" />
                        <ui:Label name="ui-scale-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:Toggle name="colorblind-toggle" label="Colorblind Mode" class="pixel-toggle" />
                    <ui:DropdownField name="colorblind-type-dropdown" label="Colorblind Type" class="pixel-dropdown" />
                </ui:VisualElement>
                <ui:VisualElement name="content-controls" class="tab-content">
                    <ui:VisualElement class="settings-field-row">
                        <ui:Label text="Sensitivity" class="settings-field-label" />
                        <ui:Slider name="mouse-sensitivity-slider" label="" low-value="0.1" high-value="10" class="pixel-slider" />
                        <ui:Label name="mouse-sensitivity-value" class="settings-field-value" />
                    </ui:VisualElement>
                    <ui:Toggle name="invert-y-toggle" label="Invert Y Axis" class="pixel-toggle" />
                </ui:VisualElement>
                <ui:VisualElement name="content-game" class="tab-content">
                    <ui:DropdownField name="language-dropdown" label="Language" class="pixel-dropdown" />
                    <ui:Toggle name="autosave-toggle" label="Auto Save" class="pixel-toggle" />
                    <ui:Toggle name="tutorials-toggle" label="Show Tutorials" class="pixel-toggle" />
                    <ui:Toggle name="screen-shake-toggle" label="Screen Shake" class="pixel-toggle" />
                    <ui:Toggle name="mature-content-toggle" label="Mature Content" class="pixel-toggle" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="settings-footer">
                <ui:Button name="apply-button" text="Apply" class="btn btn-primary" />
                <ui:Button name="reset-button" text="Reset" class="btn btn-secondary" />
                <ui:Button name="cancel-button" text="Cancel" class="btn btn-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
