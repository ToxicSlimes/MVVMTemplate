.counter-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-deep);
    align-items: center;
    justify-content: center;
}

.counter-panel,
.gallery-panel {
    width: 90%;
    max-width: 520px;
    padding: var(--space-lg);
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    align-items: stretch;
}

.gallery-panel {
    display: none;
}

.counter-value {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--color-accent);
    -unity-text-align: middle-center;
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
}

.counter-meta {
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.counter-actions {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--space-md);
}

.btn {
    min-height: 44px;
    border-radius: var(--radius-md);
    margin: var(--space-xs);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    color: var(--color-text-primary);
    border-width: 0;
}

.btn-primary {
    background-color: var(--color-primary);
    min-width: 64px;
    font-size: 24px;
}

.btn-secondary {
    background-color: var(--color-bg-elevated);
}

.btn-outline {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-text-secondary);
    min-width: 64px;
    font-size: 24px;
}

.btn-danger {
    background-color: var(--color-danger);
}

.gallery-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
}

.gallery-subtitle {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    white-space: normal;
}

.gallery-scroll {
    max-height: 160px;
    margin-bottom: var(--space-sm);
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
}

.confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    display: none;
}

.confirm-dialog {
    width: 80%;
    max-width: 420px;
    padding: var(--space-lg);
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-lg);
}

.confirm-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
}

.confirm-message {
    font-size: 14px;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-bottom: var(--space-lg);
}

.confirm-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.text-card {
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-md);
}

.text-card-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
}

.text-card-description {
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.stat-bar {
    margin-bottom: var(--space-sm);
}

.stat-bar-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
}

.stat-label,
.stat-value {
    font-size: 13px;
    color: var(--color-text-primary);
}

.stat-track {
    height: 8px;
    background-color: var(--color-bg-deep);
    border-radius: 4px;
    overflow: hidden;
}

.stat-fill {
    height: 100%;
    background-color: var(--color-primary);
    width: 0%;
}

.action-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm);
    margin-bottom: var(--space-sm);
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-md);
}

.action-item-text {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.item-title {
    font-size: 14px;
    color: var(--color-text-primary);
}

.item-subtitle {
    font-size: 12px;
    color: var(--color-text-secondary);
}

.item-action-button {
    min-width: 72px;
}
