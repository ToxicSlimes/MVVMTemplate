.counter-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-deep);
    background-image: linear-gradient(180deg, var(--color-sky-top) 0%, var(--color-sky-bottom) 50%, var(--color-bg-deep) 100%);
    align-items: center;
    justify-content: center;
}

.counter-panel,
.gallery-panel {
    width: 90%;
    max-width: 520px;
    align-items: stretch;
}

.gallery-panel {
    display: none;
}

.counter-value {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 48px;
    color: var(--color-accent);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--color-text-shadow);
    -unity-text-align: middle-center;
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
}

.counter-meta {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-candy-blue);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-lg);
}

.counter-actions {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--space-md);
}

.counter-actions .btn {
    min-width: 72px;
    margin: var(--space-xs);
    font-size: 16px;
}

.gallery-title {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 14px;
    color: var(--color-accent);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-shadow);
    margin-bottom: var(--space-sm);
}

.gallery-subtitle {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    white-space: normal;
}

.gallery-scroll {
    max-height: 160px;
    margin-bottom: var(--space-sm);
}

.confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 8, 40, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.confirm-dialog {
    width: 80%;
    max-width: 420px;
}

.confirm-title {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 12px;
    color: var(--color-danger);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-shadow);
    margin-bottom: var(--space-sm);
}

.confirm-message {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-bottom: var(--space-lg);
}

.confirm-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.text-card {
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-none);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-panel-light);
    border-top-color: var(--color-panel-light);
    border-right-color: var(--color-panel-dark);
    border-bottom-color: var(--color-panel-dark);
}

.text-card-title {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 9px;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
}

.text-card-description {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.stat-bar {
    margin-bottom: var(--space-sm);
}

.stat-bar-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
}

.stat-label,
.stat-value {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-primary);
}

.stat-track {
    height: 12px;
    background-color: var(--color-bg-deep);
    border-radius: var(--radius-none);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-panel-dark);
    border-top-color: var(--color-panel-dark);
    border-right-color: var(--color-panel-light);
    border-bottom-color: var(--color-panel-light);
    overflow: hidden;
}

.stat-fill {
    height: 100%;
    background-color: var(--color-primary);
    width: 0%;
    border-radius: var(--radius-none);
}

.action-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm);
    margin-bottom: var(--space-sm);
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-none);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-panel-light);
    border-top-color: var(--color-panel-light);
    border-right-color: var(--color-panel-dark);
    border-bottom-color: var(--color-panel-dark);
}

.action-item-text {
    flex-grow: 1;
    margin-right: var(--space-sm);
}

.item-title {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 8px;
    color: var(--color-text-primary);
}

.item-subtitle {
    -unity-font-definition: url('../Theme/Fonts/PressStart2P-Regular.ttf');
    font-size: 7px;
    color: var(--color-text-secondary);
}

.item-action-button {
    min-width: 72px;
}
